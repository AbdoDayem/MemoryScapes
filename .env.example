# Copy to .env and fill in for local development.
# API database. Default: a SQLite file at services/api/data/memoryscapes.db (no setup).
# Postgres later (npm run infra:up): postgresql+psycopg://memoryscapes:memoryscapes@localhost:5432/memoryscapes
# DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memories
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Audio pipeline backends (see services/workers/memoryscapes_workers/backends.py)
AUDIO_TAGGER=clap
SEPARATOR=audiosep
SEPARATOR_SPEECH=demucs
AUDIOSEP_CONFIG=config/audiosep_base.yaml
AUDIOSEP_CHECKPOINT=checkpoint/audiosep_base_4M_steps.ckpt
DETECTOR=grounding-dino

# SATIE (Attractor Labs) via its MCP server. Use SOUNDSCAPE_PROVIDER=stub to develop without it.
SOUNDSCAPE_PROVIDER=stub
SOUNDSCAPE_FALLBACK=stub
SATIE_MCP_URL=https://www.satie.world/mcp
# Sign the worker in once with `memoryscapes-worker satie-login` (saves .satie/worker-token.json,
# git-ignored; SATIE_TOKEN_FILE moves it). SATIE_MCP_TOKEN, if set, overrides that login.
SATIE_MCP_TOKEN=
# The API's address as viewers reach it; SATIE's runtime loads the stems from here.
PUBLIC_API_URL=http://localhost:8000
# Also upload the stems to SATIE (kept there as provided samples; on Free, used for training).
SATIE_UPLOAD_STEMS=false
# Spend cap per memory in cents. 0 = only free reuse (our own stems, library clips).
SATIE_MAX_CENTS=0
# Allow SATIE to add sounds that weren't in the recording.
SATIE_ALLOW_GENERATION=false

NEXT_PUBLIC_API_URL=http://localhost:8000
