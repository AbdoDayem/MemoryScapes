# Copy to .env and fill in for local development.
DATABASE_URL=postgresql://memoryscapes:memoryscapes@localhost:5432/memoryscapes
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memories
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# SATIE (Attractor Labs). Use SOUNDSCAPE_PROVIDER=stub to develop without it.
SOUNDSCAPE_PROVIDER=stub
SATIE_API_URL=
SATIE_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000
