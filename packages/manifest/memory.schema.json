{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryManifest",
  "description": "Relative URLs (e.g. \"splat/lods/lod0.spz\") are relative to the memory's asset base, which the API returns next to the manifest.",
  "type": "object",
  "required": ["id", "version", "coord_frame", "splat", "audio", "meta"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "coord_frame": {
      "type": "object",
      "required": ["units", "up"],
      "properties": {
        "units": { "const": "meters" },
        "up": { "enum": ["+y", "+z"] },
        "origin_geo": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "heading_deg": { "type": "number" }
      }
    },
    "splat": {
      "type": "object",
      "required": ["lods"],
      "properties": {
        "lods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "count": { "type": "integer" },
              "rad": { "$ref": "#/$defs/lodTree", "description": "This level as a Spark LoD tree for streaming (lods[0] for desktops, lods[1] for phones)" }
            }
          }
        },
        "rad": {
          "$ref": "#/$defs/lodTree",
          "description": "Older manifests: the tree of lods[0]. Newer ones put each level's tree on the level (lods[i].rad)"
        },
        "antialiased": {
          "type": "boolean",
          "description": "Trained with anti-aliasing (Mip-Splatting style, gsplat's antialiased mode): the viewer then blurs with opacity compensation. Missing or false: classic 3DGS training, drawn with the classic fixed 0.3 px² dilation"
        }
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "spawn": { "type": "object" },
        "walkable_bounds": { "type": "object" },
        "original_path": { "type": "string" },
        "floor_y": { "type": "number", "description": "Ground height in the world frame" },
        "eye_height_m": { "type": "number", "description": "Camera height above the ground during capture" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "ambient_bed": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "format": { "enum": ["mono", "stereo", "ambisonic_foa", "ambisonic_hoa"] }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "url"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "url": { "type": "string" },
              "position": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "trajectory": { "type": ["string", "null"] },
              "ref_distance": { "type": "number" },
              "rolloff": { "type": "number" },
              "gain": { "type": "number" },
              "loop": { "type": "boolean" },
              "confidence": { "type": "number" },
              "method": { "enum": ["av", "doa", "av+doa", "diffuse", "narration"] }
            }
          }
        },
        "soundscape_provider": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "job_id": { "type": "string" },
            "version": { "type": "string" },
            "fallback_reason": { "type": "string" }
          }
        },
        "satie": {
          "description": "Present when SATIE produced the soundscape. The viewer plays it with satie-runtime and falls back to `sources` otherwise.",
          "type": ["object", "null"],
          "required": ["script_url", "samples_url", "host_map"],
          "properties": {
            "script_url": { "type": "string" },
            "samples_url": { "type": "string" },
            "host_map": {
              "description": "SATIE host id -> audio source id; bind each host at that source's position.",
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "visibility": { "enum": ["private", "unlisted", "public"] },
        "owner": { "type": "string" }
      }
    }
  },
  "$defs": {
    "lodTree": {
      "type": "object",
      "description": "A splat as a Spark LoD tree for streaming: a chunked .rad header (Spark's build-lod) and the chunk files it names, in the same folder",
      "required": ["url", "chunks"],
      "properties": {
        "url": { "type": "string" },
        "chunks": { "type": "array", "items": { "type": "string" } },
        "count": { "type": "integer", "description": "Splats in the tree, interior nodes included" }
      }
    }
  }
}
